# PostgreSQL connection string. Required.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aurex_lms?schema=public

# JWT signing secrets. Use long random strings. Required.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Optional. Core LMS features run without Redis.
# When set, publish/email/certificate work can be queued with BullMQ.
REDIS_URL=

# SMTP. When unset, messages are written to the backend log instead of sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@aurex.local

# Optional object storage. Local disk under /public is used when unset.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payment provider. Card data is never stored.
# When unset, only free workshops complete automatically.
# Paid workshops create an order and wait for provider verification.
PAYMENT_PROVIDER=dev
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
PORT=4000
NODE_ENV=development

# Local seed accounts. Change these before seeding a shared database.
SEED_ADMIN_EMAIL=admin@aurex.local
SEED_ADMIN_PASSWORD=
SEED_ORGANIZER_EMAIL=organizer@aurex.local
SEED_ORGANIZER_PASSWORD=
SEED_PARTICIPANT_EMAIL=participant@aurex.local
SEED_PARTICIPANT_PASSWORD=

VITE_API_URL=/api
