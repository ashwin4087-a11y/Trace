{
  "name": "aurex-lms-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "dotenv -e ../.env -- prisma generate --schema ../database/prisma/schema.prisma",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev --schema ../database/prisma/schema.prisma",
    "db:deploy": "dotenv -e ../.env -- prisma migrate deploy --schema ../database/prisma/schema.prisma",
    "db:seed": "dotenv -e ../.env -- tsx ../database/seed/seed.ts",
    "db:reset": "dotenv -e ../.env -- tsx ../database/scripts/reset-db.ts"
  },
  "prisma": {
    "schema": "../database/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.1",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.5",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
