generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  ORGANIZER
  PARTICIPANT
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum PreferredLanguage {
  EN
  TA
  EN_TA
}

enum AcademicDomain {
  ENGINEERING
  ARTS_SCIENCE
  TAMIL_LANGUAGE
  OTHER
}

enum WorkshopStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum DeliveryMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum OrderStatus {
  FREE
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum MaterialType {
  PDF
  PPT
  DOCUMENT
  VIDEO
  URL
  RECORDING
  IMAGE
  OTHER
}

enum MaterialStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ActivityType {
  ASSIGNMENT
  PRACTICAL_TASK
  PROJECT
  SURVEY
  EXERCISE
  RESOURCE_BASED
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SubmissionType {
  TEXT
  FILE
  URL
  TEXT_AND_FILE
  TEXT_AND_URL
  NONE
}

enum QuestionType {
  MCQ_SINGLE
}

enum SubmissionStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  COMPLETED
  RETURNED
  LATE
}

enum AssessmentType {
  QUIZ
  MCQ
  OBJECTIVE
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum AttendanceMethod {
  MANUAL
  QR
  CORRECTION
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum NotificationType {
  WORKSHOP_PUBLISHED
  REGISTRATION_CONFIRMED
  SESSION_REMINDER
  CERTIFICATE_ISSUED
  ANNOUNCEMENT
  SYSTEM
}

enum CommunityPostType {
  DISCUSSION
  QUESTION
  POLL
  RESOURCE
}

enum CommunityMemberRole {
  MEMBER
  MODERATOR
  OWNER
}

enum LearningPathStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE_USER
  UPDATE_USER
  SUSPEND_USER
  CREATE_ORGANIZER
  CREATE_ORGANIZATION
  CHANGE_ROLE
  CHANGE_PERMISSION
  CREATE_WORKSHOP
  PUBLISH_WORKSHOP
  MODIFY_ATTENDANCE
  GENERATE_CERTIFICATE
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              UserRole          @default(PARTICIPANT)
  status            AccountStatus     @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?
  preferredLanguage PreferredLanguage @default(EN)
  organizationId    String?
  departmentId      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization            Organization?            @relation(fields: [organizationId], references: [id])
  department              Department?              @relation(fields: [departmentId], references: [id])
  academicProfile         AcademicProfile?
  interests               UserInterest[]
  skills                  UserSkill[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  organizedWorkshops      Workshop[]               @relation("WorkshopOrganizer")
  trainerSessions         WorkshopSession[]        @relation("SessionTrainer")
  registrations           Registration[]
  attendanceRecords       Attendance[]             @relation("AttendanceSubject")
  attendanceRecorded      Attendance[]             @relation("AttendanceRecorder")
  certificates            Certificate[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  communityMemberships    CommunityMember[]
  communityPosts          CommunityPost[]
  communityComments       CommunityComment[]
  pollVotes               CommunityPollVote[]
  learningPathEnrollments LearningPathEnrollment[]
  assessmentAttempts      AssessmentAttempt[]
  activitySubmissions     ActivitySubmission[]
  activityReviews         ActivitySubmission[]     @relation("SubmissionReviewer")
  orders                  Order[]
  announcements           Announcement[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  recommendations         Recommendation[]

  @@index([role, status])
  @@index([organizationId])
  @@index([departmentId])
}

model Role {
  id          String           @id @default(uuid())
  name        UserRole         @unique
  description String
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Organization structure
// ---------------------------------------------------------------------------

model Organization {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  users       User[]
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  workshops      Workshop[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model AcademicProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  institution    String
  domain         AcademicDomain
  departmentName String?
  year           Int?
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserInterest {
  id     String @id @default(uuid())
  userId String
  label  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@index([userId])
}

model Skill {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  category    String?
  users       UserSkill[]
  workshops   WorkshopSkill[]
}

model UserSkill {
  id                    String           @id @default(uuid())
  userId                String
  skillId               String
  level                 ProficiencyLevel @default(BEGINNER)
  verified              Boolean          @default(false)
  evidenceCertificateId String?
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill                 Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  evidence              Certificate?     @relation(fields: [evidenceCertificateId], references: [id])

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

// ---------------------------------------------------------------------------
// Workshops, commerce, learning
// ---------------------------------------------------------------------------

model Workshop {
  id                   String             @id @default(uuid())
  organizerId          String
  departmentId         String?
  organizationId       String?
  title                String
  slug                 String             @unique
  description          String?
  shortDescription     String?
  bannerImage          String?
  category             String?
  domain               AcademicDomain?
  level                ProficiencyLevel?
  trainerName          String?
  trainerProfile       String?
  startDate            DateTime?
  endDate              DateTime?
  durationHours        Float?
  mode                 DeliveryMode?
  location             String?
  capacity             Int?
  waitlistEnabled      Boolean            @default(true)
  registrationDeadline DateTime?
  language             PreferredLanguage?
  meetingUrl           String?
  meetingProvider      String?
  venue                String?
  price                Float              @default(0)
  priceCents           Int                @default(0)
  currency             String             @default("INR")
  certificateEnabled   Boolean            @default(false)
  status               WorkshopStatus     @default(DRAFT)
  skills               String[]           @default([])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  publishedAt          DateTime?
  cancelledAt          DateTime?

  organizer         User                   @relation("WorkshopOrganizer", fields: [organizerId], references: [id])
  department        Department?            @relation(fields: [departmentId], references: [id])
  workshopSkills    WorkshopSkill[]
  sessions          WorkshopSession[]
  registrations     Registration[]
  materials         LearningMaterial[]
  activities        Activity[]
  assessments       Assessment[]
  announcements     Announcement[]
  certificates      Certificate[]
  community         Community?
  learningPathLinks LearningPathWorkshop[]
  recommendations   Recommendation[]

  @@index([status, domain])
  @@index([organizerId])
  @@index([departmentId])
  @@index([language])
  @@index([registrationDeadline])
  @@index([slug])
  @@index([organizationId])
}

model WorkshopSkill {
  workshopId String
  skillId    String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([workshopId, skillId])
}

model WorkshopSession {
  id           String        @id @default(uuid())
  workshopId   String
  title        String
  sessionDate  DateTime
  startTime    DateTime
  endTime      DateTime
  trainerId    String?
  trainerName  String?
  meetingUrl   String?
  recordingUrl String?
  venue        String?
  status       SessionStatus @default(SCHEDULED)
  qrTokenHash     String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sessionNumber   Int?
  mode            DeliveryMode?
  meetingProvider String?

  workshop   Workshop           @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  trainer    User?              @relation("SessionTrainer", fields: [trainerId], references: [id])
  attendance Attendance[]
  materials  LearningMaterial[]
  activities Activity[]

  @@index([workshopId, sessionDate])
}

model Registration {
  id         String             @id @default(uuid())
  workshopId String
  userId     String
  status      RegistrationStatus
  registeredAt DateTime           @default(now())
  confirmedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workshop   Workshop           @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  order      Order?
  attendance Attendance[]

  @@unique([workshopId, userId])
  @@index([userId])
  @@index([workshopId, status])
}

model Order {
  id             String       @id @default(uuid())
  userId         String
  registrationId String       @unique
  amountCents    Int
  currency       String
  status         OrderStatus
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id])
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  payment        Payment?
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  provider          String
  providerReference String?
  status            PaymentStatus
  amountCents       Int
  currency          String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([providerReference])
}

model LearningMaterial {
  id              String           @id @default(uuid())
  workshopId      String
  sessionId       String?
  title           String
  description     String?
  type            MaterialType
  url             String
  fileName        String?
  mimeType        String?
  fileSize        Int?
  durationSeconds Int?
  sortOrder       Int              @default(0)
  status          MaterialStatus   @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workshop        Workshop         @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  session         WorkshopSession? @relation(fields: [sessionId], references: [id])

  @@index([workshopId])
  @@index([sessionId])
}

model Activity {
  id             String               @id @default(uuid())
  workshopId     String
  sessionId      String?
  title          String
  description    String
  instructions   String?
  type           ActivityType
  status         ActivityStatus       @default(DRAFT)
  sortOrder      Int                  @default(0)
  isRequired     Boolean              @default(true)
  dueAt          DateTime?
  maxScore       Int?
  submissionType SubmissionType       @default(NONE)
  resourceUrl    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  
  workshop       Workshop             @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  session        WorkshopSession?     @relation(fields: [sessionId], references: [id])
  submissions    ActivitySubmission[]

  @@index([workshopId])
  @@index([sessionId])
}

model ActivitySubmission {
  id            String           @id @default(uuid())
  activityId    String
  userId        String
  textContent   String?
  submissionUrl String?
  fileUrl       String?
  fileName      String?
  mimeType      String?
  status        SubmissionStatus @default(NOT_STARTED)
  score         Int?
  feedback      String?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  
  activity      Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer      User?            @relation("SubmissionReviewer", fields: [reviewedBy], references: [id])

  @@unique([activityId, userId])
  @@index([userId])
}

model Assessment {
  id              String                 @id @default(uuid())
  workshopId      String
  sessionId       String?
  title           String
  description     String?
  instructions    String?
  type            AssessmentType         @default(QUIZ)
  status          AssessmentStatus       @default(DRAFT)
  durationMinutes Int?
  passScore       Int                    @default(50)
  maxAttempts     Int                    @default(1)
  isRequired      Boolean                @default(true)
  dueAt           DateTime?
  sortOrder       Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  publishedAt     DateTime?
  
  workshop        Workshop               @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  questions       AssessmentQuestion[]
  attempts        AssessmentAttempt[]

  @@index([workshopId])
}

model AssessmentQuestion {
  id           String             @id @default(uuid())
  assessmentId String
  prompt       String
  type         QuestionType
  options      Json?
  correctIndex Int?
  points       Int                @default(1)
  explanation  String?
  sortOrder    Int
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers      AssessmentAnswer[]

  @@index([assessmentId])
}

model AssessmentAttempt {
  id            String             @id @default(uuid())
  assessmentId  String
  userId        String
  attemptNumber Int
  status        AttemptStatus      @default(IN_PROGRESS)
  score         Int?
  maxScore      Int?
  percentage    Float?
  passed        Boolean?
  startedAt     DateTime           @default(now())
  submittedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  assessment    Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers       AssessmentAnswer[]

  @@unique([assessmentId, userId, attemptNumber])
  @@index([assessmentId])
  @@index([userId])
}

model AssessmentAnswer {
  id                  String             @id @default(uuid())
  attemptId           String
  questionId          String
  selectedOptionIndex Int?
  isCorrect           Boolean?
  marksAwarded        Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  attempt             AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question            AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model Attendance {
  id             String           @id @default(uuid())
  sessionId      String
  registrationId String
  userId         String
  status         AttendanceStatus
  method         AttendanceMethod
  note           String?
  recordedById   String?
  recordedAt     DateTime         @default(now())
  session        WorkshopSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  registration   Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user           User             @relation("AttendanceSubject", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy     User?            @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  @@unique([sessionId, registrationId])
  @@index([userId])
  @@index([sessionId])
}

model Certificate {
  id                   String                   @id @default(uuid())
  certificateCode      String                   @unique
  userId               String
  workshopId           String
  attendancePercentage Float
  status               CertificateStatus        @default(ISSUED)
  pdfPath              String?
  issuedAt             DateTime                 @default(now())
  user                 User                     @relation(fields: [userId], references: [id])
  workshop             Workshop                 @relation(fields: [workshopId], references: [id])
  verification         CertificateVerification?
  skillEvidence        UserSkill[]

  @@unique([userId, workshopId])
  @@index([certificateCode])
}

model CertificateVerification {
  id                String      @id @default(uuid())
  certificateId     String      @unique
  lastVerifiedAt    DateTime?
  verificationCount Int         @default(0)
  certificate       Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String    @id @default(uuid())
  workshopId  String?
  authorId    String
  title       String
  body        String
  publishedAt DateTime  @default(now())
  workshop    Workshop? @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id])

  @@index([workshopId])
  @@index([authorId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id                String  @id @default(uuid())
  userId            String  @unique
  emailEnabled      Boolean @default(true)
  inAppEnabled      Boolean @default(true)
  workshopAlerts    Boolean @default(true)
  sessionReminders  Boolean @default(true)
  certificateAlerts Boolean @default(true)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id         String   @id @default(uuid())
  userId     String
  workshopId String
  score      Float
  reasons    Json
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@unique([userId, workshopId])
  @@index([userId, score])
}

// ---------------------------------------------------------------------------
// Community, learning paths, analytics, platform
// ---------------------------------------------------------------------------

model Community {
  id          String            @id @default(uuid())
  workshopId  String            @unique
  name        String
  description String?
  createdAt   DateTime          @default(now())
  workshop    Workshop          @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  posts       CommunityPost[]
}

model CommunityMember {
  id          String              @id @default(uuid())
  communityId String
  userId      String
  role        CommunityMemberRole @default(MEMBER)
  joinedAt    DateTime            @default(now())
  community   Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityPost {
  id          String             @id @default(uuid())
  communityId String
  authorId    String
  type        CommunityPostType  @default(DISCUSSION)
  title       String
  body        String
  hidden      Boolean            @default(false)
  createdAt   DateTime           @default(now())
  community   Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      User               @relation(fields: [authorId], references: [id])
  comments    CommunityComment[]
  poll        CommunityPoll?

  @@index([communityId, createdAt])
}

model CommunityComment {
  id        String        @id @default(uuid())
  postId    String
  authorId  String
  body      String
  hidden    Boolean       @default(false)
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id])

  @@index([postId])
}

model CommunityPoll {
  id      String              @id @default(uuid())
  postId  String              @unique
  options Json
  post    CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes   CommunityPollVote[]
}

model CommunityPollVote {
  id          String        @id @default(uuid())
  pollId      String
  userId      String
  optionIndex Int
  createdAt   DateTime      @default(now())
  poll        CommunityPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model LearningPath {
  id          String                   @id @default(uuid())
  title       String
  description String
  domain      AcademicDomain?
  status      LearningPathStatus       @default(DRAFT)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  steps       LearningPathWorkshop[]
  enrollments LearningPathEnrollment[]
}

model LearningPathWorkshop {
  id             String       @id @default(uuid())
  learningPathId String
  workshopId     String
  position       Int
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  workshop       Workshop     @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, position])
  @@unique([learningPathId, workshopId])
  @@index([workshopId])
}

model LearningPathEnrollment {
  id             String       @id @default(uuid())
  learningPathId String
  userId         String
  completedSteps Int          @default(0)
  enrolledAt     DateTime     @default(now())
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, userId])
  @@index([userId])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId])
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime    @default(now())
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id])

  @@index([action, createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
}

model PlatformSetting {
  id                    String              @id @default("platform")
  platformName          String              @default("AUREX LMS")
  defaultLanguage       PreferredLanguage   @default(EN)
  supportedLanguages    PreferredLanguage[]
  timezone              String              @default("Asia/Kolkata")
  registrationOpen      Boolean             @default(true)
  certificateMinPercent Int                 @default(90)
  notificationsEnabled  Boolean             @default(true)
  maintenanceMode       Boolean             @default(false)
  updatedAt             DateTime            @updatedAt
}
